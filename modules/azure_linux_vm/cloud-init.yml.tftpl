#cloud-config
package_update: true
packages:
  - python3
  - python3-apt
  - curl
  - ca-certificates
users:
  - name: ${admin_username}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}
runcmd:
  - echo "azure-vm ready for ansible" > /etc/iac-lab
