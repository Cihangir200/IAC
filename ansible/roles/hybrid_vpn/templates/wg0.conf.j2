[Interface]
Address = {{ wireguard_address }}/24
PrivateKey = {{ wireguard_private_key }}
ListenPort = {{ wireguard_listen_port | default(51820) }}

{% if inventory_hostname == 'azure' %}
PostUp = sysctl -w net.ipv4.ip_forward=1

[Peer]
PublicKey = {{ hostvars['esxi'].wireguard_public_key }}
AllowedIPs = {{ hostvars['esxi'].wireguard_address }}/32
{% else %}
[Peer]
PublicKey = {{ hostvars['azure'].wireguard_public_key }}
AllowedIPs = {{ hostvars['azure'].wireguard_address }}/32
Endpoint = {{ hostvars['azure'].ansible_host }}:{{ hostvars['azure'].wireguard_listen_port | default(51820) }}
PersistentKeepalive = 25
{% endif %}
