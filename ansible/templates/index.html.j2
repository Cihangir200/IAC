<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>IAC Hybrid Lab</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #172033;
      background: #f4f7fb;
    }
    main {
      max-width: 760px;
      margin: 10vh auto;
      padding: 32px;
      background: white;
      border: 1px solid #d9e2ef;
      border-radius: 8px;
    }
    h1 {
      margin-top: 0;
      font-size: 32px;
    }
    dl {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 12px;
    }
    dt {
      font-weight: 700;
    }
  </style>
</head>
<body>
  <main>
    <h1>IAC Hybrid Lab</h1>
    <p>Deze pagina draait via Docker Compose op een door Terraform gemaakte VM.</p>
    <dl>
      <dt>Host</dt>
      <dd>{{ inventory_hostname }}</dd>
      <dt>Groep</dt>
      <dd>{{ group_names | join(', ') }}</dd>
      <dt>Private IP</dt>
      <dd>{{ ansible_default_ipv4.address | default('onbekend') }}</dd>
      <dt>Managed by</dt>
      <dd>Terraform, CloudInit, Ansible en Docker</dd>
    </dl>
  </main>
</body>
</html>

